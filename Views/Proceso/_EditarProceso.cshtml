@model MAC.Models.Proceso
<script>
    document.querySelectorAll('.icon-option').forEach(item => {
        item.addEventListener('click', function() {
            document.getElementById('icono').value = this.dataset.icon;
        });
    });
</script>
<div class="modal fade" id="modalEditarProceso" tabindex="-1" role="dialog" aria-labelledby="modalEditarProcesoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEditarProcesoLabel">Editar Proceso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarProceso">
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Descripción</label>
                            <input type="text" class="form-control" asp-for="descr"  />
                        </div>
                        <div class="col-md-6">
                            <label>Controlador</label>
                            <input type="text" class="form-control" asp-for="controlador"  />
                        </div>
                        <div class="col-md-6">
                            <label>Acción</label>
                            <input type="text" class="form-control" asp-for="accion"  />
                        </div>
                        <div class="col-md-6">
                            <label>icono</label>
                            <div class="input-group">
                                <input type="text" id="icono" name="icono" class="form-control" placeholder="Selecciona un ícono" readonly>
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fa fa-icons"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-home"><i class="fa fa-home"></i> Home</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-user"><i class="fa fa-user"></i> Usuario</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-cog"><i class="fa fa-cog"></i> Configuración</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-id-badge"><i class="fa fa-id-badge"></i> ID Badge</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-list"><i class="fa fa-list"></i> Lista</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-link"><i class="fa fa-link"></i> Enlace</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-user-cog"><i class="fa fa-user-cog"></i> UsrConfig</a></li>
                                    <li><a class="dropdown-item icon-option" data-icon="fa fa-tools"><i class="fa fa-tools"></i> Herramientas</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>orden</label>
                            <input type="text" class="form-control" asp-for="orden" />
                        </div>
                        <div class="col-md-6">
                            <label>Padre ID</label>
                            <input type="text" class="form-control" asp-for="padreId" />
                        </div>                        
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="GuardarCambiosProceso()">Guardar</button>
            </div>
        </div>
    </div>
</div>

