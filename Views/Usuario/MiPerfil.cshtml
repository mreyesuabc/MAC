@model MAC.Models.ViewModels.PerfilUsuarioViewModel
@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombreCompleto = @ViewBag.NombreCompleto as string ?? "Usuario";
    var roles = @ViewBag.Roles as string ?? "";
}
    <div class="wrapper">
        <main class="content">
            <div class="flex-grow-1 p-3 bg-white">
                <h2>Datos Generales / Cambio Contraseña</h2>
                <form id="formRegistro">
                    <div class="row">
                        <div class="col-12 col-md-4">
                            <span class="fw-bold">Nombre</span>
                            <input type="text" id="nombre" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.nombre">
                        </div>
                        <div class="col-12 col-md-4">
                            <span class="fw-bold">Ap. Paterno </span>
                            <input type="text" id="apPaterno" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.appaterno">
                        </div>
                        <div class="col-12 col-md-4">
                            <span class="fw-bold">Ap. Materno</span>
                            <input type="text" id="apMaterno" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.apmaterno">
                        </div>
                        <div class="col-12 col-md-4">
                            <span class="fw-bold">Usuario App </span>
                            <input type="text" id="usuarioApp" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.usuarioapp">
                        </div>
                        <div class="col-12 col-md-4">
                            <span class="fw-bold">Correo </span>
                            <input type="email" id="correo" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.correo">
                        </div>
                        <div class="col-12 col-md-2">
                            <span class="fw-bold">RFC </span>
                            <input type="text" id="rfc" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.rfc">
                        </div>
                        <div class="col-12 col-md-2">
                            <span class="fw-bold">Homoclave</span>
                            <input type="text" id="homoclave" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.homoclave">
                        </div>
                        <div class="col-12 col-md-2">
                            <span class="fw-bold">Municipio</span>
                            <input type="text" id="txtMpo" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.mpoInfo.descr">
                        </div>
                        <div class="col-12 col-md-2">
                            <span class="fw-bold">Rol</span>
                            <input type="text" id="txtRol" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.Usuario.rolInfo.descr">
                        </div>
                    </div>
                </form>
            </div>
            <div class="p-3 bg-white">
                <h3>Cambiar Contraseña</h3>
                <div class="alert alert-warning">
                    <span class="fa fa-info-circle"></span>
                    "Si desea cambiar su Contraseña, ingrese
                    la actual y por la nueva que va a reemplazar. Al finalizar,
                    se le enviará un correo confirmando su nueva Contraseña de acceso."
                </div>
            </div>
            @using (Html.BeginForm("CambiarPassword", "Usuario", FormMethod.Post, new { @class = "row" }))
            {
                @Html.AntiForgeryToken()

                <div class="col-12 col-md-3">
                    <span class="fw-bold">Contraseña Actual</span>
                    @Html.PasswordFor(m => m.CambioPassword.Actual, new { @class = "form-control", required = "required" })
                </div>
                <div class="col-12 col-md-3">
                    <span class="fw-bold">Contraseña Nueva</span>
                    @Html.PasswordFor(m => m.CambioPassword.Nueva, new { @class = "form-control", required = "required" })
                </div>
                <div class="col-12 mb-3">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            }
        </main>
    </div>  
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>    