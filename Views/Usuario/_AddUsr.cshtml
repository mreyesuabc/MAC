@model MAC.Models.ViewModels.UsuarioViewModel

<div class="modal" id="myModal" aria-hidden="true">
    <div class="modal-content">
        <form asp-controller="Usuario" asp-action="AddUsr" method="post">
           <div class="row">
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Nombre</span>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Ap. Paterno</span>
                    <input asp-for="ApPaterno" class="form-control" />
                </div>
                <div class="col-4">
                    <span class="fw-bold">Ap. Materno</span>
                    <input asp-for="ApMaterno" class="form-control" />
                </div>
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Usuario App</span>
                    <input asp-for="UsuarioApp" class="form-control" />
                </div>
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Correo</span>
                    <input asp-for="Correo" type="email" class="form-control" />
                </div>
                <div class="col-2">
                    <span class="text-danger">*</span><span class="fw-bold">RFC</span>
                    <input asp-for="RFC" class="form-control mayusculas" />
                </div>
                <div class="col-2">
                    <span class="text-danger">*</span><span class="fw-bold">Homoclave</span>
                    <input asp-for="Homoclave" class="form-control mayusculas" />
                </div>
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Municipio</span>
                    <select asp-for="Municipio" asp-items="Model.Municipios" class="form-select"></select>
                </div>
                <div class="col-4">
                    <span class="text-danger">*</span><span class="fw-bold">Rol de Usuario</span>
                    <select asp-for="Rol" asp-items="Model.Roles" class="form-select"></select>
                </div>
                <input asp-for="Password" type="hidden" />
            </div>

            <br /><br />
            <div class="form-group col-sm-4 text-right" style="align-items: end;">
                <ul class="list-inline text-right">
                    <li>
                        <button class="btn btn-block btn-sm btn-primary" style="width: 200px; text-align: center;" type="submit" id="btnGuardar">
                            <span class="fa fa-check"></span> Guardar Cambios
                        </button>
                    </li>
                    <li>
                        <button class="btn btn-sm btn-warning" style="width: 200px; text-align: center;" type="button" id="btnCerrar" onclick="closeModal()">
                            <span class="fa fa-times"></span> Cerrar
                        </button>
                    </li>
                </ul>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const usuarioInput = document.getElementById("UsuarioApp");
        const passwordInput = document.getElementById("Password");

        if (usuarioInput && passwordInput) {
            usuarioInput.addEventListener("input", function () {
                passwordInput.value = usuarioInput.value;
            });
        }
    });
</script>