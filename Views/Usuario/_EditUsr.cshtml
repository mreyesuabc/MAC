@model MAC.Models.Usuario
@{
    Layout = null;
}
<div class="modal fade" id="myModalEdit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Usuario" asp-action="EditUsr" method="post">
                <div class="row">
                    <input type="hidden" name="id" value="@Model.id" />
                    <div class="col-4">
                        <span class="text-danger">*</span><span class="fw-bold">Nombre</span>
                        <input type="text" id="nombre" name="nombre" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.nombre" disabled>
                    </div>
                    <div class="col-4">
                        <span class="text-danger">*</span><span class="fw-bold">Ap. Paterno </span>
                        <input type="text" id="apPaterno" name="apPaterno" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.appaterno" disabled>
                    </div>
                    <div class="col-4">
                        <span class="fw-bold">Ap. Materno</span>
                        <input type="text" id="apMaterno" name="apMaterno" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.apmaterno" disabled>
                    </div>
                    <div class="col-4">
                        <span class="text-danger">*</span><span class="fw-bold">Usuario App </span>
                        <input type="text" id="usuarioApp" name="usuarioApp" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.usuarioapp" disabled>
                    </div>
                    <div class="col-4">
                        <span class="text-danger">*</span><span class="fw-bold">Correo </span>
                        <input type="email" id="correo" name="correo" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.correo">
                    </div>
                    <div class="col-2">
                        <span class="text-danger">*</span><span class="fw-bold">RFC </span>
                        <input type="text" id="rfc" name="rfc" class="form-control mayusculas" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.rfc">
                    </div>
                    <div class="col-2">
                        <span class="text-danger">*</span><span class="fw-bold">Homoclave</span>
                        <input type="text" id="homoclave" name="homoclave" class="form-control mayusculas" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" value="@Model.homoclave">
                    </div>
                    <div class="col-4">
                        <span class="text-danger">*</span><span class="fw-bold">Municipio </span>
                        <select id="municipio" name="municipio" class="form-select">
                            <option value="1">Mexicali</option>
                            <option value="2">Tijuana</option>
                            <option value="3">Ensenada</option>
                            <option value="4">Rosarito</option>
                        </select>
                    </div>
                    <div class="col-4" style="display:none;">
                        <input type="text" id="password" name="password" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default">
                    </div>
                    <br>
                </div>
                <br><br>
                <div class="form-group col-sm-4 text-right" style="align-items: end;">
                    <ul class="list-inline text-right">
                        <li><button class="btn btn-block btn-sm btn-primary" style="width: 200px; text-align: center;" type="submit" id="btnGuardar"><span class="fa fa-check"></span>Guardar Cambios</button></li>
                        <li><button class="btn btn-sm btn-warning" style="width: 200px; text-align: center;" type="button" id="btnCerrar" onclick="closeModal()"><span class="fa fa-times"></span>Cerrar</button></li>
                    </ul>
                </div>            
            </form>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const usuarioInput = document.getElementById("usuarioApp");
        const passwordInput = document.getElementById("password");

        usuarioInput.addEventListener("input", function () {
            passwordInput.value = usuarioInput.value;
        });
    });
</script>
