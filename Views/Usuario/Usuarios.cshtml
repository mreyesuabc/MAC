@model IEnumerable<MAC.Models.Usuario>
@{
    ViewBag.Title = "Usuarios del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombreCompleto = ViewBag.NombreCompleto as string ?? "Usuario";
    var roles = ViewBag.Roles as string ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
</head>
<body>

    <!-- Main content -->
    <main class="col-md-10 p-4">
        <div class="form-group col-sm-12 text-right">
            <ul class="list-inline text-right">
                <li>
                    <button class="btn btn-outline-secondary btn-sm" style="width: 200px;" type="button" id="btnAgregar" onclick="openModal()">
                        <span class="fa fa-plus-circle text-primary"></span> Agregar
                    </button>
                </li>
                <li>
                    <button class="btn btn-outline-secondary grid-exportar-excel btn-sm" style="width: 200px;" type="button" id="btExcel" onclick="exportTableToExcel('tablaConsulta', 'datos')">
                        <span class="fa fa-file-excel-o text-success"></span> Exportar Excel
                    </button>
                </li>
            </ul>
        </div>

        <h2>Lista de Usuarios</h2>
        @if (TempData["Mensaje"] != null)
        {
            <div id="mensajeExito" class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (TempData["Errores"] != null)
        {
            var errores = TempData["Errores"] as List<string>;
            <div id="mensajeError" class="alert alert-danger">
                <ul>
                    @foreach (var error in errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <table class="table table-striped" style="border:thin" id="tablaConsulta">
            <thead>
                <tr>
                    <th>Acciones</th>
                    <th>Usuario App</th>
                    <th>Nombre</th>
                    <th>Ap. Paterno</th>
                    <th>Ap. Materno</th>
                    <th>RFC</th>
                    <th>Homoclave</th>
                    <th>Correo</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm " title="Editar" onclick="editarUsuario('@usuario.id')">
                                <i class="fa fa-pencil" style="cursor: pointer; color:#9d2449; font-size: 16px;"></i>
                            </button>
                            <button class="btn btn-sm " title="Reiniciar contraseña" onclick="reiniciarPassword('@usuario.id')">
                                <i class="fa fa-key" style="cursor: pointer; color: #9d2449; font-size: 16px;"></i>
                            </button>
                            <button class="btn btn-sm " title="Eliminar" onclick="eliminarUsuario('@usuario.id')">
                                <i class="fa fa-trash" style="cursor: pointer; color:#9d2449; font-size: 16px;"></i>
                            </button>
                        </td>
                        <td>@usuario.usuarioapp</td>
                        <td>@usuario.nombre</td>
                        <td>@usuario.appaterno</td>
                        <td>@usuario.apmaterno</td>
                        <td>@usuario.rfc</td>
                        <td>@usuario.homoclave</td>
                        <td>@usuario.correo</td>                        
                    </tr>
                }
            </tbody>
        </table>
    </main>

    @Html.Partial("_AddUsr")
    <script>
        function openModal() {
            const modalElement = document.getElementById("myModal");
            const modal = new bootstrap.Modal(modalElement);
            modal.show();
            setTimeout();
        }

        function editarUsuario(id) {
            window.location.href = '/Usuario/Editar/' + id;
        }

        function reiniciarPassword(id) {
            if (confirm("¿Deseas reiniciar la contraseña de este usuario?")) {
                window.location.href = '/Usuario/ReiniciarPassword/' + id;
            }
        }

        function eliminarUsuario(id) {
            if (confirm("¿Estás seguro de que deseas eliminar este usuario?")) {
                fetch('/Usuario/Eliminar/' + id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        mostrarMensaje(data.mensaje, true);
                        setTimeout(() => {
                            window.location.href = '/Usuario/Index';
                        }, 1500);
                    } else {
                        mostrarMensaje(data.mensaje, false);
                    }
                })
                .catch(error => {
                    mostrarMensaje("Error al eliminar el usuario.", false);
                });
            }
        }
        function mostrarMensaje(mensaje, exito) {
            const div = document.getElementById("mensajeExito");
            div.className = `alert ${exito ? 'alert-success' : 'alert-danger'}`;
            div.textContent = mensaje;
            div.style.display = "block";
        }

        setTimeout(function () {
            const mensajeExito = document.getElementById("mensajeExito");
            const mensajeError = document.getElementById("mensajeError");
           
            if (mensajeExito) mensajeExito.style.display = "none";
            if (mensajeError) mensajeError.style.display = "none";
           
        }, 2000);
    </script>

</body>
</html>
