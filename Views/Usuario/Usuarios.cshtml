@model IEnumerable<MAC.Models.Usuario>
@{
    ViewBag.Title = "Usuarios del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombreCompleto = ViewBag.NombreCompleto as string ?? "Usuario";
    var roles = ViewBag.Roles as string ?? "";
}
@if (TempData["Mensaje"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="toastMensaje" class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Mensaje"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
@if (TempData["Errores"] != null && (TempData["Errores"] as List<string>)?.Any() == true)
{
    var errores = TempData["Errores"] as List<string> ?? new List<string>();
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="toastErrores" class="toast text-bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <strong>Errores al guardar:</strong>
                    <ul class="mb-0">
                        @foreach (var error in errores)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
<!DOCTYPE html>
<html lang="es">
<head>
</head>
<body>

    <!-- Main content -->
    <main class="col-md-12 p-4">
        <div class="form-group col-sm-12 text-right">
            <ul class="list-inline text-right">
                <li>
                    <button class="btn btn-outline-secondary btn-sm" style="width: 200px;" type="button" id="btnAgregar" onclick="openModal()">
                        <span class="fa fa-plus-circle text-primary"></span> Agregar
                    </button>
                </li>
                <li>
                    
                </li>
            </ul>
        </div>

        <h2>Lista de Usuarios</h2>       
        <table class="table table-striped" style="border:thin" id="tablaConsulta">
            <thead>
                <tr>
                    <th>Acciones</th>
                    <th>Usuario App</th>
                    <th>Nombre</th>
                    <th>Ap. Paterno</th>
                    <th>Ap. Materno</th>
                    <th>RFC</th>
                    <th>Homoclave</th>
                    <th>Correo</th>
                    <th>Municipio</th>
                    <th>Rol de Usuario</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm " title="Editar" onclick="editarUsuario('@usuario.id')">
                                <i class="fa fa-pencil" style="cursor: pointer; color:#9d2449; font-size: 16px;"></i>
                            </button>
                            <button class="btn btn-sm " title="Reiniciar contraseña" onclick="reiniciarPassword('@usuario.id')">
                                <i class="fa fa-key" style="cursor: pointer; color: #9d2449; font-size: 16px;"></i>
                            </button>
                            <button class="btn btn-sm " title="Eliminar" onclick="eliminarUsuario('@usuario.id')">
                                <i class="fa fa-trash" style="cursor: pointer; color:#9d2449; font-size: 16px;"></i>
                            </button>
                        </td>
                        <td>@usuario.usuarioapp</td>
                        <td>@usuario.nombre</td>
                        <td>@usuario.appaterno</td>
                        <td>@usuario.apmaterno</td>
                        <td>@usuario.rfc</td>
                        <td>@usuario.homoclave</td>
                        <td>@usuario.correo</td>
                        <td>@usuario.mpoInfo.descr</td>
                        <td>@usuario.rolInfo.descr</td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </main>

    <!-- Contenedor para cargar el modal de edición -->
    <div id="modalContainer"></div>
    @await Html.PartialAsync("_AddUsr", (MAC.Models.ViewModels.UsuarioViewModel)ViewBag.ViewModelUsuario)
    <script>
        function openModal() {
            const modalElement = document.getElementById("myModal");
            const modal = new bootstrap.Modal(modalElement);
            modal.show();
            setTimeout();
        }
        function editarUsuario(id) {
            alert("entre a editar usuario");
            $.ajax({
                url: '/Usuario/EditarUsuarioParcial?id=' + id,
                type: 'GET',
                success: function (data) {
                    $('#modalContainer').html(data);
                      const modalElement = document.getElementById("modalEditarUsuario");
                      const modal = new bootstrap.Modal(modalElement);
                      modal.show();                    
                }
            });
        }
       function guardarCambiosUsuario() {
            var formData = $('#formEditarUsuario').serialize();
            $.ajax({
                url: '/Usuario/GuardarCambiosUsuario',
                type: 'POST',
                data: formData,
                success: function () {
                    $('#modalContainer .modal').modal('hide');
                    location.reload(); // o actualizar solo la tabla
                }
            });
        }

        function reiniciarPassword(id) {
            if (confirm("¿Deseas reiniciar la contraseña de este usuario?")) {
                window.location.href = '/Usuario/ReiniciarPassword/' + id;
            }
        }
        function eliminarUsuario(id) {
            if (confirm("¿Estás segura de que deseas eliminar este usuario?")) {
                const form = document.createElement("form");
                form.method = "post";
                form.action = "/Usuario/Eliminar";

                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }        
    </script>
    <script>
        setTimeout(function () {
            var toastSuccess = document.getElementById('toastMensaje');
            if (toastSuccess) {
                var toast = bootstrap.Toast.getOrCreateInstance(toastSuccess);
                toast.hide();
            }

            var toastError = document.getElementById('toastErrores');
            if (toastError) {
                var toast = bootstrap.Toast.getOrCreateInstance(toastError);
                toast.hide();
            }
        }, 5000); // se ocultan después de 5 segundos
    </script>


</body>
</html>
