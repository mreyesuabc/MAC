@model IEnumerable<MAC.Models.Rol>
@{
    ViewBag.Title = "Roles del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombreCompleto = ViewBag.NombreCompleto as string ?? "Usuario";
    var roles = ViewBag.Roles as string ?? "";
}
<style>
    input.descripcion[disabled] {
        border: none;
        background-color: transparent;
        padding: 0;
        margin: 0;
        outline: none;
        box-shadow: none;
        width: 100%;
        font-size: inherit;
        font-family: inherit;
    }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.activo-checkbox').on('change', function () {
                var id = $(this).data('id');
                var activo = $(this).is(':checked') ? 1 : 0;

                $.ajax({
                    url: '/Rol/ActualizarActivo',
                    type: 'POST',
                    data: { id: id, activo: activo },
                    success: function () {
                                           },
                    error: function () {
                        alert('Error al actualizar el estado');
                    }
                });
            });
        });
    </script>
}
    <!-- Main content -->
    <main class="col-md-10 p-4">
        <div class="form-group col-sm-12 text-right">
            <ul class="list-inline text-right">
                <li>
                    <button class="btn btn-outline-secondary btn-sm" style="width: 200px;" type="button" id="btnAgregar" onclick="openModal()">
                        <span class="fa fa-plus-circle text-primary"></span> Agregar
                    </button>
                </li>                
            </ul>
        </div>

        <h2>Administración de Roles</h2>
       <table class="table table-striped" style="border:thin" id="tablaConsulta">
            <thead>
                <tr>
                    <th>Accion</th>
                    <th>Rol</th>
                    <th>Descripción</th>
                    <th>Activo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model)
                {
                    <tr>
                        <td>
                        <button class="btn btn-sm " title="Editar" onclick="editarRol('@rol.Id')">
                                <i class="fa fa-pencil" style="cursor: pointer; color:#9d2449; font-size: 16px;"></i>
                        </button>                       
                    </td>
                        <td>@rol.Id</td>
                    <td>
                        <input type="text"
                               value="@rol.descr"
                               class="descripcion"
                               data-id="@rol.Id"
                               disabled />
                    </td>

                        <td>
                            <input type="checkbox"
                                   class="activo-checkbox"
                                   data-id="@rol.Id"
                                   @(rol.activo == 1 ? "checked" : "") />
                        </td>
                    </tr>                 
                }
            </tbody>
        </table>

       
    </main>

    <!-- Contenedor para cargar el modal de edición -->
    <div id="modalContainer"></div>

    @Html.Partial("_AddRol")
    <script>
         function openModal() {
             const modalElement = document.getElementById("myModal");
             const modal = new bootstrap.Modal(modalElement);
             modal.show();
             setTimeout();
         }        

        function editarRol(id) {
            const input = document.querySelector(`input.descripcion[data-id="${id}"]`);

            if (!input) return;

            input.disabled = false;
            input.focus();

            // Evitar múltiples bindings
            input.removeEventListener('blur', input._blurHandler);
            input.removeEventListener('keypress', input._keypressHandler);

            // Definir handlers
            input._blurHandler = function () {
                guardarDescripcion(id, input.value, input);
            };

            input._keypressHandler = function (e) {
                if (e.key === 'Enter') {
                    guardarDescripcion(id, input.value, input);
                }
            };

            // Asignar eventos
            input.addEventListener('blur', input._blurHandler);
            input.addEventListener('keypress', input._keypressHandler);
        }
      function guardarDescripcion(id, nuevaDescripcion, input) {
            fetch('/Rol/ActualizarDescripcion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `id=${encodeURIComponent(id)}&descripcion=${encodeURIComponent(nuevaDescripcion)}`
            })
            .then(response => {
                if (response.ok) {
                    input.disabled = true;
                    console.log('Descripción actualizada');
                } else {
                    alert('Error al actualizar');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al actualizar');
            });
        }
      function verProcesoRol(rolId) {
        $.get('/RolProceso/VerProcesosPorRol', { rolId: rolId }, function (data) {
            $('#contenidoProcesosRol').html(data);
            $('#modalProcesosRol').modal('show');
        });
    }


</script>
