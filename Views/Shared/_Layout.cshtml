@using System.Text.Json
@using MAC.Models.ViewModels
@{
    var procesosJson = Context.Session.GetString("ProcesosPermitidos");
    var procesos = JsonSerializer.Deserialize<List<ProcesoViewModel>>(procesosJson ?? "[]");

    var padres = procesos
        .Where(p => string.IsNullOrWhiteSpace(p.padreId))
        .OrderBy(p => p.orden)
        .ToList();
    var nombreCompleto = Context.Session.GetString("NombreCompleto");
    var roles = Context.Session.GetString("Roles");
    var currentController = ViewBag.CurrentController as string ?? "";
    var currentAction = ViewBag.CurrentAction as string ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        header {
            background-color: #5c2134;
            color: white;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            font-weight: bold;
        }

        .header-right {
            text-align: right;
        }

            .header-right span {
                display: block;
            }

        aside {
            width: 285.75px;
            min-width: 285.75px;
            max-width: 285.75px;
            background-color: whitesmoke;
            padding: 5px;
            height: calc(100vh - 100px);
            box-sizing: border-box;
            border-right: 1px solid #ccc; /* Borde sutil a la derecha */
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1); /* sombra lateral */
        }
        aside ul {
                list-style: none;
                padding: 0;
                margin: 0;
        }

        aside ul ul {
               padding-left: 20px;
               margin-top: 5px;
        }

        a.menu_parent {
            color: #71798f;
            background: #FFFFFF;
            padding: 5px;
            display: block;
            border-radius: 5px;
        }

        a.menu_activo {
            color: #71798f;
            background: #EEEEEE;
            padding: 10px;
            display: block;
            border-radius: 5px;
            font-weight: bold;
        }

        a.menu_parent, a.menu_activo {
            display: flex;
            align-items: center;
            height: 44px;
            padding: 0 10px;
            border-radius: 5px;
            text-decoration: none;
            color: #71798f;
            white-space: nowrap; /* evita que el texto se divida en varias líneas */
            overflow: hidden;
            text-overflow: ellipsis;
            transition: background-color 0.5s ease, color 0.5s ease;
            border-bottom: 1px solid #ddd; /* línea sutil entre opciones */
        }

        .menu-padre > a {
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .submenu {
            padding-left: 15px;
            margin-top: 5px;
            transition: all 0.3s ease;
        }

        .fa-chevron-down.rotated {
            transform: rotate(180deg);
            transition: transform 0.3s ease;
        }

        .rotated {
            transform: rotate(180deg);
            transition: transform 0.3s ease;
        }


        nav {
            width: 200px;
            background-color:whitesmoke; /* #f0f0f0; */
            padding: 20px;
            height: calc(100vh - 100px);
        }

            nav ul {
                list-style: none;
                padding: 0;
            }

                nav ul li {
                    margin-bottom: 10px;
                }

                    nav ul li a {
                        text-decoration: none;
                        color: #333;
                    }

        main {
            flex-grow: 1;
            padding: 20px;
        }

        .layout-container {
            display: flex;
        }

        footer {
            background-color: #eee;
            text-align: center;
            padding: 10px;
        }

        .invisible {
            visibility: hidden;
        }

    </style>
</head>
<body>
    <!-- Encabezado -->
    <header>
        <div class="header-left">
            <img src="/img/logo-header.png" alt="GobBC">
            <h1 class="sr-only">Armonización Contable</h1>
        </div>
        <div class="header-right">
            <span>@nombreCompleto</span>
            <span>@roles</span>
            <a href="/Login" title="Cerrar Sesión" style="font-size:30px; color: white; margin-left: 10px;"> <i class="fa fa-power-off"></i></a>
            

        </div>
    </header>

    <!-- Menú lateral + contenido -->
    <div class="layout-container">
        <aside>
            <ul>
                @foreach (var padre in padres)
                {
                    var padreId = padre.Id;
                    var hijos = procesos.Where(h => h.padreId == padreId.ToString())
                    .OrderBy(h => int.Parse(h.orden.ToString()));

                    var controlador = padre.controlador.ToString();
                    var accion = padre.accion.ToString();
                    var icono = padre.icono.ToString();
                    var descr = padre.descr.ToString();
                    var esActivo = currentController == controlador && currentAction == accion;
                    var tieneHijoActivo = hijos.Any(h =>
                    string.Equals(currentController, h.controlador.ToString(), StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(currentAction, h.accion.ToString(), StringComparison.OrdinalIgnoreCase)
                    );

                    var esPadreActivo = esActivo || tieneHijoActivo;

                    <li class="menu-padre">
                        @if (hijos.Any())
                        {
                            <a href="javascript:void(0);" class="toggle-submenu @(esActivo ? "menu_activo" : "menu_parent")">
                                <span class="menu-icon fa @icono"></span> @descr
                                <i class="fa fa-chevron-down ms-auto @(tieneHijoActivo ? "rotated" : "")"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="@controlador" asp-action="@accion" class="@(esActivo ? "menu_activo" : "menu_parent")">
                               <span class="menu-icon fa @icono"></span> @descr
                               <i class="fa fa-chevron-down ms-auto invisible"></i>  <!-- ícono invisible para mantener alineación -->
                             </a>
                        }

                        @if (hijos.Any())
                        {
                            <ul class="submenu" style="display:@(tieneHijoActivo ? "block" : "none");">

                                 @foreach (var hijo in hijos)
                                  {
                                    var hControlador = hijo.controlador.ToString();
                                    var hAccion = hijo.accion.ToString();
                                    var hIcono = hijo.icono.ToString();
                                    var hDescr = hijo.descr.ToString();
                                    var esHijoActivo = string.Equals(currentController, hControlador, StringComparison.OrdinalIgnoreCase)
                                    && string.Equals(currentAction, hAccion, StringComparison.OrdinalIgnoreCase);
                                         <li>
                                            <a class="@(esHijoActivo ? "menu_activo" : "menu_parent")"
                                               asp-controller="@hControlador" asp-action="@hAccion">
                                                <span class="menu-icon fa @hIcono"></span> @hDescr
                                            </a>
                                        </li>
                                    }

                            </ul>
                        }
                    </li>
                }
            </ul>
        </aside>

        <main>
            @RenderBody()            
        </main>
    </div>

    <!-- Pie de página -->
    <footer>
        MGTIC Proyecto final
    </footer>

    <!-- jQuery (si lo usas) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS (versión 5) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- site JS  -->
    <script src="~/js/site.js"> </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toggle-submenu').forEach(function (toggle) {
                const chevron = toggle.querySelector('.fa-chevron-down');
                const submenu = toggle.nextElementSibling;

                if (chevron && submenu && submenu.classList.contains('submenu')) {
                    chevron.addEventListener('click', function (event) {
                        event.stopPropagation();
                        const isVisible = submenu.style.display === 'block';
                        submenu.style.display = isVisible ? 'none' : 'block';
                        chevron.classList.toggle('rotated', !isVisible);
                    });
                }
            });
        });
    </script>

    <!-- Renderiza los scripts específicos de cada vista -->
    @RenderSection("Scripts", required: false)
    @Html.Partial("_MensajesTempData")
    </body>
</html> 