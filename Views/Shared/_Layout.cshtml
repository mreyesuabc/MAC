@{
    var nombreCompleto = Context.Session.GetString("NombreCompleto");
    var roles = Context.Session.GetString("Roles");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous"/>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        header {
            background-color: #5c2134;
            color: white;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            font-weight: bold;
        }

        .header-right {
            text-align: right;
        }

            .header-right span {
                display: block;
            }

        nav {
            width: 200px;
            background-color:whitesmoke; /* #f0f0f0; */
            padding: 20px;
            height: calc(100vh - 100px);
        }

            nav ul {
                list-style: none;
                padding: 0;
            }

                nav ul li {
                    margin-bottom: 10px;
                }

                    nav ul li a {
                        text-decoration: none;
                        color: #333;
                    }

        main {
            flex-grow: 1;
            padding: 20px;
        }

        .layout-container {
            display: flex;
        }

        footer {
            background-color: #eee;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>
<body>
    <!-- Encabezado -->
    <header>
        <div class="header-left">
            <img src="/img/logo-header.png" alt="GobBC">
            <h1 class="sr-only">Armonización Contable</h1>
        </div>
        <div class="header-right">
            <span>@nombreCompleto</span>
            <span>@roles</span>
            <a href="/Login" title="Cerrar Sesión" style="font-size:30px; color: white; margin-left: 10px;"> <i class="fa fa-power-off"></i></a>
            

        </div>
    </header>

    <!-- Menú lateral + contenido -->
    <div class="layout-container">
        <nav>
            <ul>
                <li><a asp-controller="Menu" asp-action="Index"><span class="menu-icon fa fa-home"></span> Inicio</a></li>
                <li><a asp-controller="Usuario" asp-action="MiPerfil"><span class="menu-icon fa fa-cog"></span> Mi Perfil</a></li>
                <li><a asp-controller="Usuario" asp-action="Usuarios"><span class="menu-icon fa fa-user"></span> Usuarios del Sistema</a></li>
                <li><a asp-controller="Dashboard" asp-action="Index"><span class="menu-icon fa fa-bar-chart"></span> Ver Dashboard</a></li>
            </ul>           
        </nav>

        <main>
            @RenderBody()
            @RenderSection("Scripts", required: false)

        </main>
    </div>

    <!-- Pie de página -->
    <footer>
        MGTIC Proyecto final
    </footer>
    <script src="~/js/site.js"></script>  
    <script src="https://code.jquery.com/jquery-3.cript"></script>
    </body>
</html>