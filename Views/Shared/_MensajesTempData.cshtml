@* Views/Shared/_MensajesTempData.cshtml *@
@if (TempData["Mensaje"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055">
        <div id="toastMensaje" class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Mensaje"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
@if (TempData["Errores"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055">
        <div id="toastErrores" class="toast text-bg-danger border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Errores"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}