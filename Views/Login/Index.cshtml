@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/mystyle.css" />
    <title>BI Armonización Contable</title>
    <style>
        .alert-login {
            background-color: #f8d7da;
            color: #721c24;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 14px;
            display: inline-block;
            margin-bottom: 10px;
            max-width: fit-content;
            border: 1px solid #f5c6cb;
        }

            .alert-login i {
                margin-right: 6px;
            }
    </style>

</head>
<body>
    <div class="text-center">
        <img src="~/img/logo-login.png" style="height: 150px; width: 270px;" class="rounded mx-auto d-block" alt="Logo" />
    </div>

    @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { id = "login-form" }))
    {
        <div class="form-group">
            <label>Usuario</label>
            <input class="form-control" type="text" id="usuarioapp" name="usuarioapp" required />
            <label>Contraseña</label>
            <input class="form-control" type="password" id="password" name="password" required />
        </div>
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <br />
                <button type="submit" class="btn btn-block btn-md btn-primary">Iniciar sesión</button>
            </div>
        </div>
        @if (ViewBag.ErrorLogin != null)
        {
            <div class="alert-login">
                <i class="fa fa-exclamation-circle"></i> @ViewBag.ErrorLogin
            </div>
        }

    }
    <footer class="footer">
        <p style="text-align: center;">2025 Proyecto Maestría MGTIC</p>
    </footer>

</body>

</html>
